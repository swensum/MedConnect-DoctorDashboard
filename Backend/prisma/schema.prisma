generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Appointment {
  id          Int      @id @default(autoincrement())
  doctorId    String
  patientName String
  age         Int?                       
  reason      String?
  type        String   @default("Chat")  
  startsAt    DateTime @default(now())   
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([doctorId])
}
enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}
 model Doctor {
  id              String    @id            // same as the Supabase user id
  phone           String    @unique
  fullName        String?
  specialization  String?
  licenseNo       String?
  experienceYears Int?
  fee             Int?
  kycStatus       KycStatus @default(NOT_SUBMITTED)
  rejectionReason String?
  createdAt       DateTime  @default(now())
  documents       KycDocument[]
}
enum KycDocKind {
  LICENSE
  DEGREE
  CLINIC_PROOF
}

model KycDocument {
  id        Int        @id @default(autoincrement())
  doctorId  String
  kind      KycDocKind
  filePath  String     // location inside the bucket, never a public URL
  fileName  String     // original name, for display
  createdAt DateTime   @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, kind])
}