generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
model Appointment {
  id          Int      @id @default(autoincrement())
  doctorId    String
  patientName String
  age         Int?                       
  reason      String?
  type        String   @default("Chat")  
  startsAt    DateTime @default(now())   
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([doctorId])
}
enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}
 model Doctor {
  id              String    @id            // same as the Supabase user id
  phone           String    @unique
  fullName        String?
  specialization  String?
  licenseNo       String?
  experienceYears Int?
  fee             Int?
  kycStatus       KycStatus @default(NOT_SUBMITTED)
  rejectionReason String?
  createdAt       DateTime  @default(now())
}